PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:5500
CORS_ALLOW_NULL_ORIGIN=false
LOG_CONTACT_MESSAGES=true

# SMTP (envio real de e-mail)
SMTP_HOST=smtp.seudominio.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario_smtp
SMTP_PASS=senha_smtp
CONTACT_TO_EMAIL=contato@seudominio.com
CONTACT_FROM_EMAIL=no-reply@seudominio.com

# EmailJS (opcional, fallback para disparo no backend)
EMAILJS_API_URL=https://api.emailjs.com/api/v1.0/email/send
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# OAuth2 (painel admin)
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_AUTHORIZE_URL=
OAUTH2_TOKEN_URL=
OAUTH2_REDIRECT_URI=http://localhost:3333/api/auth/oauth2/callback
OAUTH2_SCOPES=openid profile email
