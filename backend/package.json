{
  "name": "advocacia-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API para o site Cardoso & Muscelli",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "http-server ../ -p 5500 -c-1 --silent",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "nodemailer": "^6.9.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/nodemailer": "^6.4.16",
    "@types/node": "^22.7.6",
    "concurrently": "^9.0.1",
    "http-server": "^14.1.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
